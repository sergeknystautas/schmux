# E2E Base Image for schmux
# Contains system deps. No Go toolchain needed —
# both the schmux binary and E2E test binary are pre-compiled locally.
# Docker build checks this file and the install script on every test run;
# unchanged layers remain cached.
#
# Build: docker build -f Dockerfile.e2e-base -t schmux-e2e-base .

FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    tmux \
    git \
    curl \
    bash \
    procps \
    util-linux \
    && rm -rf /var/lib/apt/lists/*

# Install sapling (sl) from latest GitHub release
COPY scripts/install-sapling.sh /tmp/install-sapling.sh
RUN /tmp/install-sapling.sh && rm /tmp/install-sapling.sh

# Set up a non-root user for running tests
RUN useradd -m -u 1000 e2e

# Verify installation
RUN tmux -V
